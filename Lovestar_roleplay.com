<style>
:root{--bg:#09090d;--panel:#121219;--panel2:#19151b;--red:#ed1837;--red2:#ff4057;--muted:#aaaab5;--line:rgba(237,24,55,.25);--white:#f7f5f7}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--white);font-family:Tahoma,Arial,sans-serif}a{color:inherit;text-decoration:none}.wrap{width:min(1160px,92%);margin:auto}.topline{height:3px;background:linear-gradient(90deg,#650817,var(--red),#ff6b7d)}header{position:sticky;top:0;z-index:20;background:rgba(9,9,13,.92);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}nav{height:76px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{display:flex;align-items:center;gap:11px;font-weight:1000;letter-spacing:1.5px}.brandmark{width:45px;height:45px;border-radius:13px;background:linear-gradient(145deg,var(--red2),#8c071d);display:grid;place-items:center;font-size:15px;box-shadow:0 8px 30px #ed183744}.brand b{color:var(--red2)}.navlinks{display:flex;align-items:center;gap:23px;color:#d4d1d7;font-size:13px}.navlinks a:hover{color:var(--red2)}.btn{border:0;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:13px 21px;border-radius:10px;background:linear-gradient(135deg,var(--red2),#b90828);color:white;font-weight:900;cursor:pointer;box-shadow:0 8px 25px #ed183733;transition:.2s}.btn:hover{transform:translateY(-2px);filter:brightness(1.1)}.btn.ghost{background:#17141a;border:1px solid var(--line);box-shadow:none}.hero{min-height:600px;display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:35px;padding:75px 0 60px;position:relative}.hero:before{content:"";position:absolute;top:20px;right:-150px;width:460px;height:460px;border-radius:50%;background:#d90c3020;filter:blur(100px);pointer-events:none}.eyebrow{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--line);border-radius:30px;background:#ed183711;color:#ff7789;padding:9px 14px;font-size:12px;font-weight:bold}.eyebrow i{width:7px;height:7px;border-radius:50%;background:#ff4057;box-shadow:0 0 12px #ff4057}.hero h1{font-size:clamp(44px,7vw,78px);line-height:1.1;letter-spacing:1px;margin:22px 0 15px;font-weight:1000}.hero h1 span{color:var(--red2);text-shadow:0 0 35px #ed183744}.lead{font-size:16px;line-height:2.1;color:var(--muted);max-width:560px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:27px}.heroart{min-height:400px;display:grid;place-items:center;position:relative}.orbit{width:min(390px,78vw);aspect-ratio:1;border-radius:50%;border:1px solid #ed18374d;display:grid;place-items:center;box-shadow:0 0 80px #ed183718,inset 0 0 70px #ed183710;position:relative}.orbit:before,.orbit:after{content:"";position:absolute;border:1px solid #ed18372e;border-radius:50%;inset:24px}.orbit:after{inset:52px;border-style:dashed}.monogram{width:66%;height:66%;border-radius:35% 65% 42% 58%;transform:rotate(-8deg);background:linear-gradient(145deg,#272027,#0c0b10);border:5px solid var(--red);display:grid;place-items:center;font-size:clamp(90px,17vw,175px);font-weight:1000;color:#fff;text-shadow:0 0 25px #ff4057;box-shadow:0 0 55px #ed183755,inset 0 0 40px #ed183722}.monogram span{font-size:22px;color:var(--red2);position:absolute;transform:rotate(8deg);top:12%;right:20%}.floatlabel{position:absolute;bottom:8%;right:0;background:#17141b;border:1px solid var(--line);border-radius:12px;padding:13px 17px;color:#ddd;font-size:12px;box-shadow:0 12px 35px #0008}.floatlabel b{color:var(--red2);display:block;font-size:15px;margin-bottom:4px}.ticker{border-block:1px solid var(--line);background:#100d12;overflow:hidden;white-space:nowrap;padding:16px 0;color:#d5cbd0;font-size:12px;letter-spacing:1px}.ticker span{color:var(--red2);padding:0 22px}.section{padding:78px 0}.heading{text-align:center;margin-bottom:36px}.heading small{color:var(--red2);font-weight:bold}.heading h2{font-size:31px;margin:10px 0}.heading h2 span{color:var(--red2)}.heading p{color:var(--muted);font-size:14px;line-height:1.9}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}.teamgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.teamcard{position:relative;overflow:hidden;text-align:center;padding:26px 17px 24px;background:linear-gradient(150deg,#20151b,#111015 72%);border:1px solid var(--line);border-radius:17px;transition:.2s}.teamcard:before{content:"";position:absolute;inset:0 0 auto;height:3px;background:linear-gradient(90deg,transparent,var(--red2),transparent)}.teamcard:hover{transform:translateY(-5px);border-color:#ff405788}.teamicon{width:62px;height:62px;margin:0 auto 15px;border-radius:18px;display:grid;place-items:center;background:#ed18371b;border:1px solid #ed183755;color:#ff657a;font-size:25px;font-weight:1000}.teamcard h3{margin:0 0 7px;font-size:17px}.teamcard strong{display:block;color:var(--red2);font-size:12px;letter-spacing:1px;direction:ltr}.teamcard p{margin:12px 0 0;color:var(--muted);font-size:12px;line-height:1.9}.tile{padding:25px;background:linear-gradient(145deg,#19151c,#101015);border:1px solid var(--line);border-radius:16px;min-height:185px;transition:.2s}.tile:hover{transform:translateY(-4px);border-color:#ed183777}.tile .ico{font-size:27px;color:var(--red2)}.tile h3{margin:15px 0 9px;font-size:17px}.tile p{margin:0;color:var(--muted);font-size:13px;line-height:2}.connection{display:grid;grid-template-columns:1fr 1fr;gap:22px;align-items:stretch}.connectbox,.steps{background:linear-gradient(145deg,#19151c,#101015);border:1px solid var(--line);border-radius:18px;padding:30px}.connectbox h3,.steps h3{margin:0 0 12px;font-size:22px}.connectbox p{color:var(--muted);line-height:1.9;font-size:14px}.serverip{direction:ltr;text-align:center;background:#09090d;border:1px dashed #ed183788;border-radius:12px;padding:17px;font-size:19px;font-weight:bold;letter-spacing:1px;margin:20px 0;color:#ff657a}.copyrow{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}.step{display:flex;gap:14px;margin:18px 0}.num{flex:0 0 34px;height:34px;border-radius:10px;background:#ed183722;color:var(--red2);display:grid;place-items:center;font-weight:bold}.step b{display:block;margin-bottom:6px}.step p{margin:0;color:var(--muted);font-size:13px;line-height:1.8}.band{background:linear-gradient(110deg,#310b16,#151017 65%,#0e0d12);border:1px solid var(--line);border-radius:22px;padding:42px;text-align:center}.band h2{font-size:29px;margin:0 0 12px}.band p{color:var(--muted);line-height:1.9;margin:0 0 22px}.faq{max-width:850px;margin:auto}.faq details{background:#141219;border:1px solid var(--line);border-radius:12px;padding:18px 20px;margin:10px 0}.faq summary{cursor:pointer;font-weight:bold}.faq p{color:var(--muted);line-height:1.9;font-size:13px}footer{border-top:1px solid var(--line);background:#08080b;padding:38px 0 22px}.footgrid{display:grid;grid-template-columns:1.5fr 1fr 1fr;gap:25px}.footgrid p,.footgrid a{font-size:13px;color:var(--muted);line-height:2}.footgrid h4{margin:0 0 10px}.copyright{text-align:center;border-top:1px solid #ffffff12;margin-top:25px;padding-top:20px;color:#77727a;font-size:12px}.mobilemenu{display:none}
@media(max-width:800px){.navlinks{display:none}.hero{grid-template-columns:1fr;text-align:center;padding:50px 0}.heroart{grid-row:1;min-height:300px}.orbit{width:280px}.lead{margin:auto}.actions{justify-content:center}.grid3{grid-template-columns:1fr}.teamgrid{grid-template-columns:repeat(2,1fr)}.connection{grid-template-columns:1fr}.footgrid{grid-template-columns:1fr 1fr}.footgrid>div:first-child{grid-column:1/-1}.hero h1{font-size:48px}.floatlabel{right:4%}.section{padding:58px 0}}
